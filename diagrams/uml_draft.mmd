classDiagram
    %% Draft UML for PawPal+ (Phase 1). Revisit and update in Phase 6.

    class Owner {
        +str name
        +int available_minutes
        +str day_start
        +list~str~ preferences
        +list~Pet~ pets
        +add_pet(pet: Pet) None
        +remove_pet(name: str) None
        +get_all_tasks() list~Task~
    }

    class Pet {
        +str name
        +str species
        +int age
        +list~Task~ tasks
        +add_task(task: Task) None
        +remove_task(title: str) None
        +get_tasks() list~Task~
    }

    class Task {
        +str title
        +int duration_minutes
        +str priority
        +str category
        +str preferred_time
        +str frequency
        +bool completed
        +mark_complete() None
        +priority_rank() int
    }

    class Scheduler {
        +Owner owner
        +generate_plan() list~tuple~
        +sort_tasks(tasks: list~Task~) list~Task~
        +filter_tasks(tasks: list~Task~) list~Task~
        +detect_conflicts(plan: list~tuple~) list~str~
        +explain_plan(plan: list~tuple~) str
    }

    Owner "1" o-- "1..*" Pet : has
    Pet "1" o-- "0..*" Task : has
    Scheduler --> Owner : plans for
