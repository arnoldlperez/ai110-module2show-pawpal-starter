classDiagram
    %% Draft UML for PawPal+ (Phase 1). Revisit and update in Phase 6.
    %% PetTask = (Pet, Task) pair. PlanItem = (start "HH:MM", Pet, Task, reason).

    class Owner {
        +str name
        +int available_minutes
        +str day_start
        +list~str~ preferences
        +list~Pet~ pets
        +add_pet(pet: Pet) None
        +remove_pet(name: str) None
        +get_all_tasks() list~PetTask~
    }

    class Pet {
        +str name
        +str species
        +int age
        +list~Task~ tasks
        +add_task(task: Task) None
        +remove_task(title: str) None
        +get_tasks() list~Task~
    }

    class Task {
        +str title
        +int duration_minutes
        +str priority
        +str category
        +str preferred_time
        +str frequency
        +date last_completed
        +mark_complete(today: date) None
        +is_due(today: date) bool
        +priority_rank() int
    }

    class Scheduler {
        +Owner owner
        +to_minutes(hhmm: str)$ int
        +to_hhmm(minutes: int)$ str
        +generate_plan(today: date) list~PlanItem~
        +sort_tasks(tasks: list~PetTask~) list~PetTask~
        +filter_tasks(tasks: list~PetTask~) list~PetTask~
        +detect_conflicts(plan: list~PlanItem~) list~str~
        +explain_plan(plan: list~PlanItem~) str
    }

    Owner "1" o-- "1..*" Pet : has
    Pet "1" o-- "0..*" Task : has
    Scheduler --> Owner : plans for
