classDiagram
    %% Final UML for PawPal+, matching pawpal_system.py.
    %% PetTask = (Pet, Task) pair. PlanItem = (start "HH:MM", Pet, Task, reason).

    class Owner {
        +str name
        +int available_minutes
        +str day_start
        +list~str~ preferences
        +list~Pet~ pets
        +add_pet(pet: Pet) None
        +remove_pet(name: str) None
        +get_all_tasks() list~PetTask~
    }

    class Pet {
        +str name
        +str species
        +int age
        +list~Task~ tasks
        +add_task(task: Task) None
        +remove_task(title: str) None
        +get_tasks() list~Task~
    }

    class Task {
        +str title
        +int duration_minutes
        +str priority
        +str category
        +str preferred_time
        +str frequency
        +date due_date
        +bool completed
        +mark_complete() None
        +is_due(today: date) bool
        +next_occurrence(today: date) Task
        +priority_rank() int
    }

    class Scheduler {
        +Owner owner
        +list~PetTask~ skipped
        +to_minutes(hhmm: str)$ int
        +to_hhmm(minutes: int)$ str
        +generate_plan(today: date) list~PlanItem~
        +sort_tasks(tasks: list~PetTask~) list~PetTask~
        +sort_by_time(tasks: list~PetTask~) list~PetTask~
        +filter_tasks(pet_name: str, completed: bool) list~PetTask~
        +fit_to_budget(tasks: list~PetTask~) list~PetTask~
        +mark_task_complete(pet: Pet, task: Task, today: date) Task
        +detect_conflicts(plan: list~PlanItem~) list~str~
        +explain_plan(plan: list~PlanItem~) str
        -_first_open_slot(duration: int, busy: list) int
    }

    Owner "1" o-- "1..*" Pet : has
    Pet "1" o-- "0..*" Task : has
    Scheduler --> Owner : plans for
    Scheduler ..> Pet : adds next occurrence to
    Task ..> Task : next_occurrence() creates
